# train_model.ipynb
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import MinMaxScaler
import tensorflow as tf
import joblib

# Load dataset
df = pd.read_csv('PS_20174392719_1491204439457_log.csv')

# Filter relevant transactions
df = df[df['type'].isin(['TRANSFER', 'CASH_OUT'])]

# Select features
features = [
    'step', 'amount',
    'oldbalanceOrg', 'newbalanceOrig',
    'oldbalanceDest', 'newbalanceDest'
]
target = 'isFraud'

# One-hot encode 'type'
df = pd.get_dummies(df, columns=['type'], drop_first=True)

# Split data
train, test = train_test_split(df, test_size=0.3, random_state=42, stratify=df['isFraud'])
val, test = train_test_split(test, test_size=0.5, random_state=42, stratify=test['isFraud'])

# Scale features
scaler = MinMaxScaler()
X_train = scaler.fit_transform(train.drop(columns='isFraud'))
X_val = scaler.transform(val.drop(columns='isFraud'))
X_test = scaler.transform(test.drop(columns='isFraud'))

y_train = train['isFraud'].values
y_val = val['isFraud'].values
y_test = test['isFraud'].values

# Reshape for GRU
X_train = X_train.reshape((X_train.shape[0], 1, X_train.shape[1]))
X_val = X_val.reshape((X_val.shape[0], 1, X_val.shape[1]))
X_test = X_test.reshape((X_test.shape[0], 1, X_test.shape[1]))

# Define GRU model
model = tf.keras.Sequential([
    tf.keras.layers.GRU(32, input_shape=(1, X_train.shape[2]), return_sequences=False),
    tf.keras.layers.Dropout(0.2),
    tf.keras.layers.Dense(16, activation='relu'),
    tf.keras.layers.Dropout(0.2),
    tf.keras.layers.Dense(1, activation='sigmoid')
])

model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])

# Train
history = model.fit(
    X_train, y_train,
    validation_data=(X_val, y_val),
    epochs=10,
    batch_size=256,
    class_weight={0: 1.0, 1: 10.0}
)

# Save model + scaler
model.save('../backend/gru_model.h5')
joblib.dump(scaler, '../backend/scaler.pkl')
